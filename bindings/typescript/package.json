{
  "name": "@glubus/minacalc",
  "version": "0.2.0",
  "description": "TypeScript bindings for MinaCalc: Node.js, Bun, and Deno",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Glubus/minacalc-rs.git",
    "directory": "bindings/typescript"
  },
  "type": "module",
  "files": ["dist", "src/bun.ts", "src/deno.ts", "src/shared.ts", "README.md"],
  "exports": {
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./bun": "./src/bun.ts",
    "./deno": "./src/deno.ts"
  },
  "engines": { "node": ">=20" },
  "dependencies": { "koffi": "^3.1.1" },
  "devDependencies": { "@types/node": "latest", "typescript": "latest" },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "publishConfig": { "access": "public" }
}
